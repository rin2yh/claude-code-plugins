#!/usr/bin/env bash
set -euo pipefail

# fav-rules pack installer.
#   Usage: install-fav-rules <category|all> [user|project] [--format claude|agents]
#     category : rules/ 直下のサブディレクトリ名 (common, ts, ...)
#     all      : 全カテゴリを一括で配置
#     scope    : user (default) / project
#     format   : claude (default) → .claude/rules/<category>/*.md をそのまま配置
#                agents           → AGENTS.md にマーカー付きブロックとして連結する
#                                   (内容は変換せずそのまま)
#
#   配置先:
#     claude + user    → ~/.claude/rules/<category>/
#     claude + project → $PWD/.claude/rules/<category>/
#     agents + user    → ~/.codex/AGENTS.md
#     agents + project → $PWD/AGENTS.md

usage() {
  echo "usage: install-fav-rules <category|all> [user|project] [--format claude|agents]" >&2
  echo "       install-fav-rules --list" >&2
}

# プラグインルートを指す環境変数はホストごとに違う。どれも無ければスクリプト位置から逆算する。
ROOT=""
for candidate in "${CLAUDE_PLUGIN_ROOT:-}" "${CODEX_PLUGIN_ROOT:-}" "${PLUGIN_ROOT:-}"; do
  if [[ -n "${candidate}" && -d "${candidate}/rules" ]]; then
    ROOT="${candidate}"
    break
  fi
done
if [[ -z "${ROOT}" ]]; then
  # シンボリックリンク越しに呼ばれても bin/ の親に辿り着けるよう解決しておく。
  self="$(readlink -f "$0" 2>/dev/null)" || self="$0"
  ROOT="${self%/*/*}"
fi

SRC_ROOT="${ROOT}/rules"
if [[ ! -d "${SRC_ROOT}" ]]; then
  echo "install-fav-rules: source rules directory not found: ${SRC_ROOT}" >&2
  exit 1
fi

# glob 展開は照合順で並ぶので sort も要らない。
list_categories() {
  local dir
  for dir in "${SRC_ROOT}"/*/; do
    [[ -d "${dir}" ]] || continue
    dir="${dir%/}"
    printf '%s\n' "${dir##*/}"
  done
}

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

if [[ "$1" == "--list" || "$1" == "-l" ]]; then
  list_categories
  exit 0
fi

CATEGORY=""
SCOPE=""
FORMAT="claude"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --format)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      FORMAT="$2"
      shift 2
      ;;
    --format=*)
      FORMAT="${1#--format=}"
      shift
      ;;
    -*)
      usage
      exit 2
      ;;
    *)
      if [[ -z "${CATEGORY}" ]]; then
        CATEGORY="$1"
      elif [[ -z "${SCOPE}" ]]; then
        SCOPE="$1"
      else
        usage
        exit 2
      fi
      shift
      ;;
  esac
done

SCOPE="${SCOPE:-user}"

if [[ -z "${CATEGORY}" ]]; then
  usage
  exit 2
fi

case "$SCOPE" in
  user|project) ;;
  *) usage; exit 2 ;;
esac

case "$FORMAT" in
  claude)
    case "$SCOPE" in
      user)    DEST_ROOT="${HOME}/.claude/rules" ;;
      project) DEST_ROOT="${PWD}/.claude/rules" ;;
    esac
    ;;
  agents)
    case "$SCOPE" in
      user)    AGENTS_FILE="${HOME}/.codex/AGENTS.md" ;;
      project) AGENTS_FILE="${PWD}/AGENTS.md" ;;
    esac
    ;;
  *) usage; exit 2 ;;
esac

# --format claude: rules/<cat>/*.md をそのままコピーする。
install_one_claude() {
  local cat="$1"
  local src="${SRC_ROOT}/${cat}"
  local dest="${DEST_ROOT}/${cat}"
  local files=( "${src}"/*.md )
  mkdir -p "${dest}"
  cp "${files[@]}" "${dest}/"
  printf 'Installed %s file(s) [%s] -> %s\n' "${#files[@]}" "${cat}" "${dest}"
}

# --format agents: カテゴリ単位でマーカーに挟んだブロックを AGENTS.md に書く。
# 追記ではなく置換にすることで、再実行しても重複しない。
install_one_agents() {
  local cat="$1"
  local src="${SRC_ROOT}/${cat}"
  local begin="<!-- fav-rules:begin ${cat} -->"
  local end="<!-- fav-rules:end ${cat} -->"

  local block
  block="$(
    printf '%s\n' "${begin}"
    # ルールはそのまま連結する。paths: フロントマターは AGENTS.md では
    # フィルタとして機能しないが、適用範囲を伝える情報としては読まれるので残す。
    for file in "${src}"/*.md; do
      printf '\n'
      cat "${file}"
    done
    printf '%s\n' "${end}"
  )"

  mkdir -p "${AGENTS_FILE%/*}"

  if [[ -f "${AGENTS_FILE}" ]] && grep -qF "${begin}" "${AGENTS_FILE}"; then
    # 既存ブロックを差し替える。awk は同じファイルを読みながら書けないので
    # ここだけ一時ファイルを経由する。
    local tmp
    tmp="$(mktemp)"
    BEGIN_MARK="${begin}" END_MARK="${end}" BLOCK="${block}" awk '
      $0 == ENVIRON["BEGIN_MARK"] { skip = 1; print ENVIRON["BLOCK"]; next }
      $0 == ENVIRON["END_MARK"] { skip = 0; next }
      !skip { print }
    ' "${AGENTS_FILE}" >"${tmp}"
    mv "${tmp}" "${AGENTS_FILE}"
    printf 'Updated block [%s] -> %s\n' "${cat}" "${AGENTS_FILE}"
  else
    # 追記するだけなので、ファイル全体を読み書きする必要はない。
    # >> は不在ファイルを作るため touch も要らない。
    [[ -s "${AGENTS_FILE}" ]] && printf '\n' >>"${AGENTS_FILE}"
    printf '%s\n' "${block}" >>"${AGENTS_FILE}"
    printf 'Appended block [%s] -> %s\n' "${cat}" "${AGENTS_FILE}"
  fi
}

install_one() {
  local cat="$1"
  local src="${SRC_ROOT}/${cat}"
  if [[ ! -d "${src}" ]]; then
    echo "install-fav-rules: unknown category '${cat}'. available: $(list_categories | tr '\n' ' ')" >&2
    return 1
  fi
  case "$FORMAT" in
    claude) install_one_claude "${cat}" ;;
    agents) install_one_agents "${cat}" ;;
  esac
}

if [[ "${CATEGORY}" == "all" ]]; then
  while IFS= read -r cat; do
    install_one "${cat}"
  done < <(list_categories)
else
  install_one "${CATEGORY}"
fi
